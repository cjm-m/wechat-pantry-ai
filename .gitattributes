* text=auto

# 部署脚本 / SQL / 配置要送进 Linux 服务器，强制 LF（否则 scp 过去带 CR，bash/psql 直接报错）
*.sh   text eol=lf
*.sql  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# 二进制资源，不做行尾转换与 diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary