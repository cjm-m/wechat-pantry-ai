<view class="page page-with-bar">
    <view class="center-box" wx:if="{{authState === 'checking'}}">
        <view class="skeleton loading-line"></view>
    </view>

    <block wx:if="{{authState === 'ready'}}">
        <!-- 空态：给四个起手式 -->
        <block wx:if="{{messages.length === 0 && !sending}}">
            <view class="intro">
                <view class="intro-icon">🍳</view>
                <view class="intro-title">家里的事，问我就行</view>
                <view class="intro-desc">我能查冰箱、排这周的菜单、算缺什么要买</view>
            </view>

            <view class="card suggest-card">
                <view
                    class="suggest-row"
                    wx:for="{{suggestions}}"
                    wx:key="*this"
                    data-text="{{item}}"
                    bindtap="onPickSuggestion"
                >
                    <text class="suggest-text">{{item}}</text>
                    <text class="suggest-arrow">›</text>
                </view>
            </view>
        </block>

        <!-- 对话记录 -->
        <view class="chat" wx:if="{{messages.length > 0}}">
            <view class="msg" wx:for="{{messages}}" wx:key="id" id="{{item.id}}">
                <block wx:if="{{item.role === 'user'}}">
                    <view class="bubble bubble-user">{{item.text}}</view>
                </block>

                <block wx:else>
                    <!-- 步骤可视化：助手做了什么，一目了然 -->
                    <view class="steps" wx:if="{{item.steps.length > 0}}">
                        <view class="step-line {{step.ok ? '' : 'is-fail'}}" wx:for="{{item.steps}}" wx:for-item="step" wx:key="tool">
                            <text class="step-icon">{{step.ok ? '✓' : '✕'}}</text>
                            <text class="step-label">{{step.label}}</text>
                            <text class="step-retry" wx:if="{{step.retried}}">重试过</text>
                            <text class="step-time" wx:if="{{step.timeText}}">{{step.timeText}}</text>
                        </view>
                    </view>

                    <view class="bubble bubble-agent">{{item.text}}</view>

                    <view class="degraded-note" wx:if="{{item.degraded}}">
                        这次没全办成，上面标红的那步失败了 —— 可以再问我一次，或者手动去对应页面处理。
                    </view>

                    <view class="truncated-note" wx:if="{{item.truncated}}">
                        这次想得有点久，先说到这。可以接着问下一步。
                    </view>

                    <view class="quick-links">
                        <text class="quick-link" bindtap="onGoMealPlan">这周菜单 ›</text>
                        <text class="quick-link" bindtap="onGoFridge">看冰箱 ›</text>
                    </view>
                </block>
            </view>

            <!-- 发送中的占位 -->
            <view class="msg" wx:if="{{sending}}">
                <view class="thinking">
                    <view class="dot"></view>
                    <view class="dot"></view>
                    <view class="dot"></view>
                    <text class="thinking-text">{{sendingText}}</text>
                </view>
            </view>
        </view>

        <view class="error-box" wx:if="{{error}}">{{error}}</view>

        <view class="clear-row" wx:if="{{messages.length > 0 && !sending}}">
            <text class="clear-link" bindtap="onClear">清空对话</text>
        </view>

        <!-- 输入条 -->
        <view class="bottom-bar">
            <input
                class="agent-input"
                value="{{draft}}"
                placeholder="问我家里的事…"
                placeholder-class="placeholder"
                maxlength="200"
                confirm-type="send"
                bindinput="onInput"
                bindconfirm="onSend"
                disabled="{{sending}}"
            />
            <view
                class="btn btn-primary btn-small send-btn {{draft === '' || sending ? 'is-disabled' : ''}}"
                bindtap="onSend"
            >{{sending ? '…' : '发送'}}</view>
        </view>
    </block>
</view>
