<view class="page page-with-bar">
    <view class="center-box" wx:if="{{authState === 'checking'}}">
        <view class="skeleton loading-line"></view>
    </view>

    <block wx:if="{{authState === 'ready'}}">
        <view class="hero">
            <view class="hero-title">今晚吃什么</view>
            <view class="hero-sub">从冰箱里挑几样，让 AI 配三道菜</view>
        </view>

        <view class="model-line" bindtap="onPickModel">
            <text class="model-label">用的模型</text>
            <text class="model-name">{{modelName ? modelName : '默认'}}</text>
            <text class="model-arrow">切换 ›</text>
        </view>

        <view class="error-box" wx:if="{{error}}">{{error}}</view>

        <view class="card section">
            <view class="row-between">
                <text class="title">已选 {{selectedCount}} 样</text>
                <view class="row">
                    <text class="link" bindtap="onSelectAll">全选</text>
                    <text class="link clear-link" bindtap="onClearSelection">清空</text>
                </view>
            </view>

            <view class="chip-list chip-wrap" wx:if="{{selectedCount > 0}}">
                <view class="chip" wx:for="{{chips}}" wx:key="id" data-id="{{item.id}}" bindtap="onRemoveChip">
                    <text>{{item.name}}</text>
                    <text class="chip-close">×</text>
                </view>
            </view>

            <view class="empty-inline" wx:else>
                <text class="sub">还没勾食材，去冰箱挑几样</text>
                <text class="link" bindtap="onGoFridge">去冰箱 ›</text>
            </view>
        </view>

        <block wx:if="{{phase === 'generating'}}">
            <view class="card section">
                <view class="row-between">
                    <text class="title">正在配菜…</text>
                    <text class="sub">{{elapsed}} 秒</text>
                </view>
                <view class="skeleton gen-line"></view>
                <view class="skeleton gen-line short"></view>
                <view class="skeleton gen-line shorter"></view>
                <view class="cancel-btn" bindtap="onCancelGenerate">取消</view>
            </view>
        </block>

        <block wx:if="{{phase === 'error'}}">
            <view class="card section">
                <view class="title">这次没配出来</view>
                <view class="error-box">{{errorText}}</view>
                <view class="btn btn-primary retry-btn" bindtap="onRegenerate">再试一次</view>
            </view>
        </block>

        <block wx:if="{{phase === 'raw'}}">
            <view class="card section">
                <view class="title">模型没有给出能解析的菜谱</view>
                <view class="sub raw-sub">下面是它的原始输出，可以直接复制去搜做法。</view>
                <scroll-view class="raw-box" scroll-y>
                    <text class="raw-text">{{rawText}}</text>
                </scroll-view>
                <view class="btn btn-primary retry-btn" bindtap="onRegenerate">重新生成</view>
            </view>
        </block>

        <block wx:if="{{phase === 'done'}}">
            <view class="card dish-card" wx:for="{{dishes}}" wx:key="key">
                <view class="row-between">
                    <text class="dish-title">{{item.title}}</text>
                    <text class="tag tag-soft" wx:if="{{item.saved}}">已收藏</text>
                </view>
                <text class="dish-summary" wx:if="{{item.summary}}">{{item.summary}}</text>

                <view class="nutrition-line" wx:if="{{item.nutrition}}">
                    <text class="nutrition-main">约 {{item.nutrition.kcal}} 千卡</text>
                    <text class="nutrition-sub">蛋白 {{item.nutrition.protein}}g · 碳水 {{item.nutrition.carb}}g · 脂肪 {{item.nutrition.fat}}g</text>
                </view>

                <view class="sub-title">要用到</view>
                <view class="used-item" wx:for="{{item.used}}" wx:for-item="unit" wx:key="name">
                    <text class="used-name">{{unit.name}}</text>
                    <text class="used-amount">{{unit.amount}}</text>
                    <text class="tag tag-warn" wx:if="{{unit.missing}}">冰箱里没有</text>
                    <text class="tag" wx:elif="{{!unit.fromFridge}}">基础调料</text>
                </view>

                <view class="sub-title">做法</view>
                <view class="step" wx:for="{{item.steps}}" wx:for-item="step" wx:for-index="si" wx:key="*this">
                    <text class="step-index">{{si + 1}}</text>
                    <text class="step-text">{{step}}</text>
                </view>

                <view class="dish-actions">
                    <view class="btn btn-soft btn-small" data-index="{{index}}" bindtap="onSaveDish">
                        {{item.saved ? '已收藏' : '收藏这道'}}
                    </view>
                    <view class="btn btn-primary btn-small" data-index="{{index}}" catchtap="onMakeThis">就做这个</view>
                </view>
            </view>

            <view class="again-line" bindtap="onRegenerate">换一批 ›</view>
        </block>

        <view class="bottom-bar">
            <view class="grow">
                <text class="sub">{{selectedCount > 0 ? '已选 ' + selectedCount + ' 样食材' : '还没选食材'}}</text>
            </view>
            <view
                class="btn btn-primary btn-small gen-btn {{phase === 'generating' ? 'is-disabled' : ''}}"
                bindtap="onGenerate"
            >{{phase === 'generating' ? '生成中…' : '生成菜谱'}}</view>
        </view>
    </block>
</view>
