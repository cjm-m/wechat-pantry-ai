.loading-line {
    width: 100%;
}

.setting-row {
    padding: 6rpx 0;
    min-height: 88rpx;
}

.time-value {
    font-size: 32rpx;
    color: var(--primary-dark);
    min-width: 140rpx;
    text-align: right;
}

.subscribe-card {
    margin-top: 20rpx;
}

.quota-note {
    margin-top: 10rpx;
