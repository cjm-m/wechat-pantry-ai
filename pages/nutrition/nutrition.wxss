/* 营养统计（M12）。环形用 conic-gradient，没有引任何图表库。 */

.today-card {
    padding: 36rpx 32rpx 28rpx;
    text-align: center;
}

.today-title {
    font-size: 26rpx;
    color: var(--muted);
    letter-spacing: 2rpx;
}

.ring {
    width: 300rpx;
    height: 300rpx;
    margin: 24rpx auto 0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    /* 兜底：conic-gradient 在极低版本不生效时仍是纯色圆，数字照样可读 */
    background: var(--primary-soft);
}

.ring-hole {
    width: 232rpx;
    height: 232rpx;
    border-radius: 50%;
    background: var(--card);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.ring-num {
    font-size: 72rpx;
    font-weight: 600;
    color: var(--primary);
    line-height: 1.1;
}

.ring-unit {
    margin-top: 4rpx;
    font-size: 24rpx;
    color: var(--muted);
}

.today-goal {
    margin-top: 24rpx;
    font-size: 24rpx;
    color: var(--muted);
}

.today-meals {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: var(--ok);
}

.macro-row {
    padding: 16rpx 0;
}

.macro-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 10rpx;
}

.macro-label {
    font-size: 28rpx;
    color: var(--text);
}

.macro-value {
    font-size: 24rpx;
    color: var(--muted);
}

.macro-track {
    height: 14rpx;
    border-radius: 7rpx;
    background: var(--line);
    overflow: hidden;
}

.macro-fill {
    height: 100%;
    border-radius: 7rpx;
    background: var(--primary);
}

.bars {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12rpx;
    height: 240rpx;
    padding-top: 16rpx;
}

.bar-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
}

.bar-slot {
    flex: 1;
    width: 100%;
    display: flex;
    align-items: flex-end;
}

.bar {
    width: 100%;
    border-radius: 8rpx 8rpx 0 0;
    background: var(--primary);
    min-height: 8rpx;
}

/* 没记录的那天画成浅色矮柱，和「吃了但热量低」区分开 */
.bar.is-empty {
    background: var(--line);
}

.bar-label {
    margin-top: 10rpx;
    font-size: 22rpx;
    color: var(--muted);
}

.note-card {
    padding: 26rpx 28rpx;
}

.note-text {
    font-size: 26rpx;
    color: var(--text);
    line-height: 1.6;
}

.note-hint {
    margin-top: 12rpx;
    font-size: 22rpx;
    color: var(--muted);
    line-height: 1.5;
}

/* sub-title 不是全局类（app.wxss 里没有），各页各写一份是这个项目的既有惯例。
   本页用到两次（三大营养素 / 近 7 天），不定义就会掉成正文大小。 */
.sub-title {
    margin-bottom: 8rpx;
    font-size: 24rpx;
    color: var(--muted);
    letter-spacing: 1rpx;
}
