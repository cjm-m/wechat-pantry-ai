<view class="page">
    <view class="center-box" wx:if="{{authState === 'checking'}}">
        <view class="skeleton loading-line"></view>
    </view>

    <block wx:if="{{authState === 'ready'}}">
        <view class="error-box" wx:if="{{error}}">{{error}}</view>

        <block wx:if="{{item}}">
            <view class="card">
                <view class="detail-title">{{item.title}}</view>
                <view class="detail-summary" wx:if="{{item.summary}}">{{item.summary}}</view>
                <view class="detail-meta">
                    <text wx:if="{{item.ownerLabel}}">{{item.ownerLabel}}收藏</text>
                    <text class="dot" wx:if="{{item.ownerLabel}}">·</text>
                    <text>{{item.timeText}}</text>
                </view>
            </view>

            <view class="card">
                <view class="sub-title">食材</view>
                <view class="used-item" wx:for="{{item.used}}" wx:key="name">
                    <text class="used-name">{{item.name}}</text>
                    <text class="used-amount">{{item.amount}}</text>
                    <text class="tag" wx:if="{{!item.fromFridge}}">基础调料</text>
                </view>
            </view>

            <view class="card">
                <view class="sub-title">做法</view>
                <view class="step" wx:for="{{item.steps}}" wx:for-item="step" wx:for-index="si" wx:key="*this">
                    <text class="step-index">{{si + 1}}</text>
                    <text class="step-text">{{step}}</text>
                </view>
            </view>

            <view class="card" wx:if="{{item.nutrition}}">
                <view class="sub-title">营养估算</view>
                <view class="nutrition-grid">
                    <view class="nutrition-cell">
                        <view class="nutrition-num">{{item.nutrition.kcal}}</view>
                        <view class="nutrition-tag">千卡</view>
                    </view>
                    <view class="nutrition-cell">
                        <view class="nutrition-num">{{item.nutrition.protein}}<text class="nutrition-g">g</text></view>
                        <view class="nutrition-tag">蛋白质</view>
                    </view>
                    <view class="nutrition-cell">
                        <view class="nutrition-num">{{item.nutrition.carb}}<text class="nutrition-g">g</text></view>
                        <view class="nutrition-tag">碳水</view>
                    </view>
                    <view class="nutrition-cell">
                        <view class="nutrition-num">{{item.nutrition.fat}}<text class="nutrition-g">g</text></view>
                        <view class="nutrition-tag">脂肪</view>
                    </view>
                </view>
                <view class="nutrition-hint">模型按用料粗估，只能看个大概。</view>
            </view>

            <view class="btn btn-primary want-btn" bindtap="onWantThis">想吃这个</view>

            <view class="btn btn-soft cook-btn" wx:if="{{item.steps.length > 0}}" bindtap="onStartCooking">开始做菜</view>

            <view class="remove-btn" bindtap="onRemove">
                {{removing ? '正在取消…' : '取消收藏'}}
            </view>
        </block>
    </block>
</view>
